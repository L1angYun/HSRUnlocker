<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CoreSourceRoot Condition="'$(CoreSourceRoot)' == ''">../../gui/Core</CoreSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreSourceRoot)/*.cs" Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(CoreSourceRoot)/../Localization/*.json">
      <LogicalName>HSRUnlocker.Localization.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
