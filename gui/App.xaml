<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="StarRailUnlocker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/MiSansVF.ttf#MiSans VF</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MiSansVF.ttf#MiSans VF</FontFamily>
            <Style x:Key="AppTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockStyle}" />
            <Style TargetType="NumberBox">
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
