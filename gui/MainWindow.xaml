<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarRailUnlocker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HSRUnlocker">

    <Grid x:Name="LayoutRoot" SizeChanged="OnLayoutSizeChanged"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="CompactSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,18,24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/AppIcon.png" Width="40" Height="40"
                   AutomationProperties.Name="HSRUnlocker" />
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="HSRUnlocker" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="SaveButton" Style="{StaticResource ToolButtonStyle}"
                    Click="OnSaveClick">
                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Save" /></Viewbox>
            </Button>
        </Grid>

        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusIcon" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="StateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1100" Padding="24,20,24,16" Spacing="24"
                        HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PathLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ClientPathBox" MinWidth="0" Height="36"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  MaxDropDownHeight="320" SelectionChanged="OnGameClientChanged"
                                  AutomationProperties.AutomationId="ClientPathBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="{Binding ActualWidth, ElementName=ClientPathBox}"
                                               ToolTipService.ToolTip="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" x:Name="ScanGamesButton" Click="OnScanGamesClick"
                                AutomationProperties.AutomationId="ScanGamesButton"
                                Style="{StaticResource ToolButtonStyle}">
                            <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Find" /></Viewbox>
                        </Button>
                        <Button Grid.Column="2" x:Name="BrowseButton" Click="OnBrowseClick"
                                Style="{StaticResource ToolButtonStyle}">
                            <Viewbox Width="16" Height="16"><SymbolIcon Symbol="OpenFile" /></Viewbox>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="ClientScanProgress" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" x:Name="ClientScanStatus" Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </StackPanel>

                <Grid ColumnSpacing="0" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="DisplaySettings" Grid.ColumnSpan="3" Spacing="20">
                        <TextBlock x:Name="DisplaySectionTitle" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FpsLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="FpsUnitText" Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FpsSlider" ValueChanged="OnFpsSliderChanged" />
                                <NumberBox Grid.Column="1" x:Name="FpsBox" SpinButtonPlacementMode="Inline"
                                           ValueChanged="OnFpsBoxChanged" />
                            </Grid>
                            <Grid x:Name="PresetPanel" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock x:Name="FpsStateText" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FovLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="ResetFovButton" Click="OnResetFovClick"
                                        Padding="4" Width="28" Height="28">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FovSlider" ValueChanged="OnFovSliderChanged" />
                                <NumberBox Grid.Column="1" x:Name="FovBox" ValueChanged="OnFovBoxChanged"
                                           SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <TextBlock x:Name="FovStateText" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="AntiFadeLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="AntiFadeStateText" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="AntiFadeToggle" Toggled="OnAntiFadeToggled"
                                          Style="{StaticResource CompactSwitchStyle}" />
                        </Grid>
                    </StackPanel>
                    <Border x:Name="SettingsDivider" Grid.Column="1" Width="1" Visibility="Collapsed"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="StartupSettings" Grid.Row="1" Grid.ColumnSpan="3"
                                Margin="0,28,0,0" Spacing="20">
                        <TextBlock x:Name="StartupSectionTitle" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="MobileUiLabel" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MobileUiHint" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="MobileUiToggle" Toggled="OnMobileUiToggled"
                                              Style="{StaticResource CompactSwitchStyle}" />
                            </Grid>
                            <ComboBox x:Name="GraphicsSourceBox" HorizontalAlignment="Stretch"
                                      IsEnabled="False" SelectionChanged="OnGraphicsSourceChanged">
                                <ComboBoxItem x:Name="GraphicsAutoItem" />
                                <ComboBoxItem x:Name="GraphicsChinaItem" />
                                <ComboBoxItem x:Name="GraphicsGlobalItem" />
                            </ComboBox>
                            <ComboBox x:Name="SafeAreaModeBox" HorizontalAlignment="Stretch" MinWidth="0"
                                      IsEnabled="False" SelectionChanged="OnSafeAreaModeChanged"
                                      AutomationProperties.AutomationId="SafeAreaModeBox">
                                <ComboBoxItem x:Name="SafeAreaOriginalItem" />
                                <ComboBoxItem x:Name="SafeAreaCustomItem" />
                            </ComboBox>
                            <StackPanel x:Name="SafeAreaInsetsPanel" Spacing="12" Visibility="Collapsed">
                                <NumberBox x:Name="SafeAreaHorizontalBox" HorizontalAlignment="Stretch" MinWidth="0"
                                           IsEnabled="False" SpinButtonPlacementMode="Inline"
                                           ValueChanged="OnSafeAreaHorizontalChanged"
                                           AutomationProperties.AutomationId="SafeAreaHorizontalBox" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoStartLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle"
                                          Style="{StaticResource CompactSwitchStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartMinimizedLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle"
                                          Style="{StaticResource CompactSwitchStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="16" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExitWithGameLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" x:Name="ExitWithGameToggle"
                                          AutomationProperties.AutomationId="ExitWithGameToggle"
                                          Toggled="OnExitWithGameToggled"
                                          Style="{StaticResource CompactSwitchStyle}" />
                        </Grid>
                        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem x:Name="LanguageAutoItem" Tag="auto" />
                            <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                            <ComboBoxItem Tag="en-US" Content="English" />
                            <ComboBoxItem Tag="ja-JP" Content="日本語" />
                            <ComboBoxItem Tag="ko-KR" Content="한국어" />
                        </ComboBox>
                        <TextBlock x:Name="FontCreditText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="12">
                    <TextBlock x:Name="UpdatesSectionTitle" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CheckForUpdatesLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" x:Name="CheckForUpdatesToggle"
                                      AutomationProperties.AutomationId="CheckForUpdatesToggle"
                                      Toggled="OnCheckForUpdatesToggled"
                                      Style="{StaticResource CompactSwitchStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SecondaryTextStyle}"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClick"
                                    AutomationProperties.AutomationId="CheckUpdatesButton"
                                    Style="{StaticResource ToolButtonStyle}">
                                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Refresh" /></Viewbox>
                            </Button>
                            <Button x:Name="ApplyUpdateButton" Click="OnApplyUpdateClick"
                                    AutomationProperties.AutomationId="ApplyUpdateButton"
                                    Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}">
                                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Download" /></Viewbox>
                            </Button>
                            <Button x:Name="CancelUpdateButton" Click="OnCancelUpdateClick"
                                    AutomationProperties.AutomationId="CancelUpdateButton"
                                    Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}">
                                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Cancel" /></Viewbox>
                            </Button>
                            <Button x:Name="OpenReleaseButton" Click="OnOpenReleaseClick"
                                    AutomationProperties.AutomationId="OpenReleaseButton"
                                    Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}">
                                <FontIcon Glyph="&#xE71B;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" AutomationProperties.AutomationId="UpdateProgressBar" />
                </StackPanel>
                <Expander x:Name="LogExpander" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" IsExpanded="False" Expanding="OnLogExpanding">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="CopyLogButton" Click="OnCopyLogClick" Style="{StaticResource ToolButtonStyle}">
                                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Copy" /></Viewbox>
                            </Button>
                            <Button x:Name="ClearLogButton" Click="OnClearLogClick" Style="{StaticResource ToolButtonStyle}">
                                <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Clear" /></Viewbox>
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="24,14"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid MaxWidth="1052" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Click="OnStartClick" HorizontalAlignment="Stretch"
                        MinWidth="0" HorizontalContentAlignment="Stretch" Padding="12,10"
                        Style="{StaticResource AccentButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Play" /></Viewbox>
                        <TextBlock Grid.Column="1" x:Name="StartButtonText" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" x:Name="AttachButton" Click="OnAttachClick" HorizontalAlignment="Stretch"
                        MinWidth="0" HorizontalContentAlignment="Stretch" Padding="12,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" FontSize="16" />
                        <TextBlock Grid.Column="1" x:Name="AttachButtonText" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Grid.Column="2" x:Name="StopButton" Click="OnStopClick" IsEnabled="False"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="16" Height="16"><SymbolIcon Symbol="Stop" /></Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
